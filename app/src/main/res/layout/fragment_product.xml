<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.product.ProductFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerImageSlider"
                android:layout_width="0dp"
                android:layout_height="400dp"
                android:background="@drawable/recyclerview_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="30dp"
                app:layout_constraintBottom_toBottomOf="@+id/viewPagerImageSlider"
                app:layout_constraintEnd_toEndOf="@+id/viewPagerImageSlider"
                app:layout_constraintStart_toStartOf="@+id/viewPagerImageSlider"
                app:tabBackground="@drawable/tab_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_images"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="@+id/text_view_product_name"
                app:layout_constraintStart_toStartOf="@+id/text_view_product_name"
                app:layout_constraintTop_toBottomOf="@+id/viewPagerImageSlider" />

            <TextView
                android:id="@+id/text_view_product_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="20dp"
                android:text="Product Name"
                android:textSize="20sp"
                android:textColor="@color/primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/recycler_view_images" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="GHS "
                android:textSize="23sp"

                app:layout_constraintStart_toStartOf="@+id/text_view_product_name"
                app:layout_constraintTop_toBottomOf="@+id/text_view_product_name" />

            <TextView
                android:id="@+id/text_view_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.00"
                android:textColor="@color/black"
                android:textSize="26sp"
                app:layout_constraintBottom_toBottomOf="@+id/textView9"
                app:layout_constraintStart_toEndOf="@+id/textView9"
                app:layout_constraintTop_toTopOf="@+id/textView9" />

            <TextView
                android:id="@+id/text_view_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="UCC, GH"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="@+id/text_view_product_name"
                app:layout_constraintTop_toTopOf="@+id/textView9" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/location"
                app:layout_constraintEnd_toStartOf="@+id/text_view_location"
                app:layout_constraintTop_toTopOf="@+id/text_view_location" />

            <Button
                android:id="@+id/button_view_contact"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/btn_primary_ripple"
                android:text="View Contact"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="@+id/text_view_product_name"
                app:layout_constraintStart_toStartOf="@+id/text_view_product_name"
                app:layout_constraintTop_toBottomOf="@+id/text_view_amount" />

            <TextView
                android:id="@+id/textView13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Description"
                android:textSize="23dp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="@+id/text_view_product_name"
                app:layout_constraintTop_toBottomOf="@+id/button_view_contact" />

            <TextView
                android:id="@+id/text_view_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ems="10"
                android:gravity="start|top"
                android:text="Product Description"
                app:layout_constraintEnd_toEndOf="@+id/text_view_product_name"
                app:layout_constraintStart_toStartOf="@+id/text_view_product_name"
                app:layout_constraintTop_toBottomOf="@+id/textView13" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint_seller"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/container_primary_ripple"
                app:layout_constraintEnd_toEndOf="@+id/text_view_product_name"
                app:layout_constraintStart_toStartOf="@+id/text_view_product_name"
                app:layout_constraintTop_toBottomOf="@+id/text_view_description">

                <ImageView
                    android:id="@+id/imageViewSeller"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/product_image_background"
                    android:outlineProvider="background"
                    android:src="@drawable/beauty"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/edit_text_seller_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Seller name"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageViewSeller"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/textView53"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Similar"
                android:textColor="@color/primary"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="@+id/text_view_product_name"
                app:layout_constraintTop_toBottomOf="@+id/constraint_seller" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_similar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView53" />


        </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>